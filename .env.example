# AIPC Event Management Platform — environment template
# Copy to .env.local. Never commit real values. Never put secrets in a Vite frontend:
# anything prefixed VITE_ is bundled into the browser build and is public.

# Which data source the service layer talks to: demo | api
VITE_DATA_ADAPTER=demo

# Future backend REST API base URL
VITE_API_BASE_URL=https://api.example.com

# Razorpay PUBLIC key id only. The key secret must live on the backend.
VITE_RAZORPAY_KEY_ID=rzp_test_placeholder

# Public site URL used for canonical tags and OpenGraph
VITE_SITE_URL=https://app.aipc.live

# ---------------------------------------------------------------------------
# BACKEND ONLY — these must never appear in this file on a deployed frontend.
# Listed here so the future Node/Fastify service knows what it needs.
#   RAZORPAY_KEY_SECRET=
#   DATABASE_URL=
#   JWT_SECRET=
#   SMTP_HOST= SMTP_USER= SMTP_PASS=
#   WHATSAPP_API_TOKEN=
#   WORDPRESS_APP_PASSWORD=
#   GRAVITY_FORMS_CONSUMER_SECRET=
